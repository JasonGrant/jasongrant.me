# Loaded by `next dev` only. A fresh clone shows the Ask Jason widget against a
# scripted stand-in (no network, no secrets). Point it at the live API in the
# ignored .env.local instead; see specs/009-ask-jason-chat/quickstart.md.

# off | private | on, set explicitly in every environment (src/lib/askJasonFlag.ts).
NEXT_PUBLIC_ASK_JASON=on

# "standin" = the scripted chat client and the ?ask=<scenario> state picker.
# Vercel sets this to https://api.jasongrant.me.
NEXT_PUBLIC_ASK_JASON_API=standin

# Cloudflare's published always-pass test site key. It is public and works on any hostname.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
